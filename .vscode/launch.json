{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug lucid-c",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/lucid-c",
            "args": [
                "${workspaceFolder}/frontend/test/test.toy",
                "-emit=mlir"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false,
            "preLaunchTask": "Build lucid-c (Debug)",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip stepping into LLVM/MLIR sources",
                    "text": "-exec skip -rf ${env:HOME}/llvm-project",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip stepping into libstdc++ headers",
                    "text": "-exec skip -rf /usr/include/c++",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
