{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug lucid-toy",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/lucid-toy",
            "args": [
                "${workspaceFolder}/frontend/toy/test/test.toy",
                "--emit=toy"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build lucid-toy (Debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": true,
            "externalConsole": false,
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true
            },
            "setupCommands": [
                {
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "source ${env:HOME}/llvm-project/mlir/utils/gdb-scripts/prettyprinters.py",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
