{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug lucid-c",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/lucid-c",
            "args": [
                "${workspaceFolder}/frontend/test/test.toy",
                "-emit=mlir",
                "-opt"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build lucid-c (Debug)",
            "initCommands": [
                "command source ${workspaceFolder}/.vscode/lldb/init.lldb",
                "command script import ${env:HOME}/llvm-project/mlir/utils/lldb-scripts/mlirDataFormatters.py"
            ]
        }
    ]
}
