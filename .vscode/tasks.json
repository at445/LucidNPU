{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lucid-c (Debug)",
            "type": "shell",
            "command": "cmake --preset debug && cmake --build --preset debug --target lucid-c",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
