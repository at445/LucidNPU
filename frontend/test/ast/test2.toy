# RUN: lucid-c %s -emit=ast 2>&1 | FileCheck %s

# User defined generic function that operates on unknown shaped arguments.
def multiply_transpose(a, b) {
  return transpose(a) * transpose(b);
}
# CHECK: Proto 'multiply_transpose'
# CHECK-NEXT: Params: [a, b]
# CHECK-NEXT: Block {
# CHECK-NEXT: Return
# CHECK-NEXT: BinOp: *
# CHECK-NEXT: Transpose [
# CHECK-NEXT: var: a
# CHECK-NEXT: ]
# CHECK-NEXT: Transpose [
# CHECK-NEXT: var: b
# CHECK-NEXT: ]

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b<2, 3> = [1, 2, 3, 4, 5, 6];

  var c = multiply_transpose(a, b);
  # CHECK: VarDecl c <>
  # CHECK-NEXT: Call 'multiply_transpose' [
  # CHECK-NEXT: var: a
  # CHECK-NEXT: var: b
  # CHECK-NEXT: ]

  var d = multiply_transpose(b, a);
  # CHECK: VarDecl d <>
  # CHECK-NEXT: Call 'multiply_transpose' [
  # CHECK-NEXT: var: b
  # CHECK-NEXT: var: a
  # CHECK-NEXT: ]

  var e = multiply_transpose(c, d);
  # CHECK: VarDecl e <>
  # CHECK-NEXT: Call 'multiply_transpose' [
  # CHECK-NEXT: var: c
  # CHECK-NEXT: var: d
  # CHECK-NEXT: ]

  var f = multiply_transpose(a, c);
  # CHECK: VarDecl f <>
  # CHECK-NEXT: Call 'multiply_transpose' [
  # CHECK-NEXT: var: a
  # CHECK-NEXT: var: c
  # CHECK-NEXT: ]
}
