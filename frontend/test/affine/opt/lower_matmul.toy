# RUN: lucid-c %s -emit=affine -opt 2>&1 | FileCheck %s

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 2], [3, 4], [5, 6]];
  var c = a @ b;
  print(c);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_C:.*]] = memref.alloc() : memref<2x2xf64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<2x3xf64>

# CHECK: affine.for %[[ARG0:.*]] = 0 to 2 {
# CHECK-NEXT: affine.for %[[ARG1:.*]] = 0 to 2 {
# CHECK-NEXT: affine.store %{{.*}}, %[[ALLOC_C]][%[[ARG0]], %[[ARG1]]] : memref<2x2xf64>
# CHECK-NEXT: affine.for %[[ARG2:.*]] = 0 to 3 {
# CHECK-NEXT: %[[VAL_A:.*]] = affine.load %[[ALLOC_A]][%[[ARG0]], %[[ARG2]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VAL_B:.*]] = affine.load %[[ALLOC_B]][%[[ARG2]], %[[ARG1]]] : memref<3x2xf64>
# CHECK-NEXT: %[[VAL_MUL:.*]] = arith.mulf %[[VAL_A]], %[[VAL_B]] : f64
# CHECK-NEXT: %[[VAL_C:.*]] = affine.load %[[ALLOC_C]][%[[ARG0]], %[[ARG1]]] : memref<2x2xf64>
# CHECK-NEXT: %[[VAL_ADD:.*]] = arith.addf %[[VAL_C]], %[[VAL_MUL]] : f64
# CHECK-NEXT: affine.store %[[VAL_ADD]], %[[ALLOC_C]][%[[ARG0]], %[[ARG1]]] : memref<2x2xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: toy.print %[[ALLOC_C]] : memref<2x2xf64>
# CHECK: return
