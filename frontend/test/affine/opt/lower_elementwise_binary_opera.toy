# RUN: lucid-c %s -emit=affine -opt 2>&1 | FileCheck %s

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 1, 1], [2, 2, 2]];
  var c = a + b;
  var d = c * c;
  var e = transpose(d);
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_RESULT:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_INPUT2:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_INPUT1:.*]] = memref.alloc() : memref<2x3xf64>

# CHECK: affine.for %[[ARG0:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[ARG1:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VAL_A:.*]] = affine.load %[[ALLOC_INPUT1]][%[[ARG1]], %[[ARG0]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VAL_B:.*]] = affine.load %[[ALLOC_INPUT2]][%[[ARG1]], %[[ARG0]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VAL_ADD:.*]] = arith.addf %[[VAL_A]], %[[VAL_B]] : f64
# CHECK-NEXT: %[[VAL_MUL:.*]] = arith.mulf %[[VAL_ADD]], %[[VAL_ADD]] : f64
# CHECK-NEXT: affine.store %[[VAL_MUL]], %[[ALLOC_RESULT]][%[[ARG0]], %[[ARG1]]] : memref<3x2xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: toy.print %[[ALLOC_RESULT]] : memref<3x2xf64>
# CHECK: return
