# RUN: lucid-c %s -emit=affine -opt 2>&1 | FileCheck %s
#
# Loop fusion: add + mul + transpose fused into one loop nest.

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 1, 1], [2, 2, 2]];
  var c = a + b;
  var d = c * c;
  var e = transpose(d);
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[R:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[B:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[A:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK: affine.for %[[I:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[J:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VA:.*]] = affine.load %[[A]][%[[J]], %[[I]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VB:.*]] = affine.load %[[B]][%[[J]], %[[I]]] : memref<2x3xf64>
# CHECK-NEXT: %[[ADD:.*]] = arith.addf %[[VA]], %[[VB]] : f64
# CHECK-NEXT: %[[MUL:.*]] = arith.mulf %[[ADD]], %[[ADD]] : f64
# CHECK-NEXT: affine.store %[[MUL]], %[[R]][%[[I]], %[[J]]] : memref<3x2xf64>
# CHECK: toy.print %[[R]] : memref<3x2xf64>
# CHECK: return
