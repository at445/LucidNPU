# RUN: lucid-c %s -emit=affine -opt 2>&1 | FileCheck %s
#
# Loop fusion: multiple element-wise ops on the same shape get fused into one loop.

def main() {
  var a = [[1, 2], [3, 4]];
  var b = [[5, 6], [7, 8]];
  var c = a + b;
  var d = c * c;
  var e = transpose(d);
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# With -opt, only 3 allocs (a, b, result) — intermediate c,d are fused away.
# CHECK-DAG: %[[ALLOC_RESULT:.*]] = memref.alloc() : memref<2x2xf64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<2x2xf64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<2x2xf64>

# Single fused loop: add + mul + transpose all in one pass
# CHECK: affine.for %[[I:.*]] = 0 to 2 {
# CHECK-NEXT: affine.for %[[J:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VA:.*]] = affine.load %[[ALLOC_A]][%[[J]], %[[I]]] : memref<2x2xf64>
# CHECK-NEXT: %[[VB:.*]] = affine.load %[[ALLOC_B]][%[[J]], %[[I]]] : memref<2x2xf64>
# CHECK-NEXT: %[[ADD:.*]] = arith.addf %[[VA]], %[[VB]] : f64
# CHECK-NEXT: %[[MUL:.*]] = arith.mulf %[[ADD]], %[[ADD]] : f64
# CHECK-NEXT: affine.store %[[MUL]], %[[ALLOC_RESULT]][%[[I]], %[[J]]] : memref<2x2xf64>

# CHECK: toy.print %[[ALLOC_RESULT]] : memref<2x2xf64>
# CHECK: return
