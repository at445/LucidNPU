# RUN: lucid-c %s -emit=affine 2>&1 | FileCheck %s

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 1, 1], [2, 2, 2]];
  var c = a + b;
  var d = c * c;
  var e = transpose(d);
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_E:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_D:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_C:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<2x3xf64>

# add: a + b -> c
# CHECK: affine.for %[[ARG0:.*]] = 0 to 2 {
# CHECK-NEXT: affine.for %[[ARG1:.*]] = 0 to 3 {
# CHECK-NEXT: %[[VA:.*]] = affine.load %[[ALLOC_A]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VB:.*]] = affine.load %[[ALLOC_B]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>
# CHECK-NEXT: %[[ADD:.*]] = arith.addf %[[VA]], %[[VB]] : f64
# CHECK-NEXT: affine.store %[[ADD]], %[[ALLOC_C]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>

# mul: c * c -> d
# CHECK: affine.for %[[ARG0:.*]] = 0 to 2 {
# CHECK-NEXT: affine.for %[[ARG1:.*]] = 0 to 3 {
# CHECK-NEXT: %[[VC:.*]] = affine.load %[[ALLOC_C]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>
# CHECK-NEXT: %[[MUL:.*]] = arith.mulf %[[VC]], %[[VC]] : f64
# CHECK-NEXT: affine.store %[[MUL]], %[[ALLOC_D]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>

# transpose: d -> e
# CHECK: affine.for %[[ARG0:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[ARG1:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VD:.*]] = affine.load %[[ALLOC_D]][%[[ARG1]], %[[ARG0]]] : memref<2x3xf64>
# CHECK-NEXT: affine.store %[[VD]], %[[ALLOC_E]][%[[ARG0]], %[[ARG1]]] : memref<3x2xf64>

# CHECK: toy.print %[[ALLOC_E]] : memref<3x2xf64>
# CHECK: return
