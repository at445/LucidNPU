# RUN: lucid-c %s -emit=affine 2>&1 | FileCheck %s

def main() {
  var a = 1;
  var b = 2;
  var c = a + b;
  var d = a * b;
  var e = c - d;
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_E:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_D:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_C:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<f64>

# a + b -> c
# CHECK: %[[VA:.*]] = affine.load %[[ALLOC_A]][] : memref<f64>
# CHECK: %[[VB:.*]] = affine.load %[[ALLOC_B]][] : memref<f64>
# CHECK: %[[ADD:.*]] = arith.addf %[[VA]], %[[VB]] : f64
# CHECK: affine.store %[[ADD]], %[[ALLOC_C]][] : memref<f64>

# a * b -> d
# CHECK: %[[VA2:.*]] = affine.load %[[ALLOC_A]][] : memref<f64>
# CHECK: %[[VB2:.*]] = affine.load %[[ALLOC_B]][] : memref<f64>
# CHECK: %[[MUL:.*]] = arith.mulf %[[VA2]], %[[VB2]] : f64
# CHECK: affine.store %[[MUL]], %[[ALLOC_D]][] : memref<f64>

# c - d -> e
# CHECK: %[[VC:.*]] = affine.load %[[ALLOC_C]][] : memref<f64>
# CHECK: %[[VD:.*]] = affine.load %[[ALLOC_D]][] : memref<f64>
# CHECK: %[[SUB:.*]] = arith.subf %[[VC]], %[[VD]] : f64
# CHECK: affine.store %[[SUB]], %[[ALLOC_E]][] : memref<f64>

# CHECK: toy.print %[[ALLOC_E]] : memref<f64>
# CHECK: return
