# RUN: lucid-c %s -emit=mlir --opt --lower_to_affine 2>&1 | FileCheck %s

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 1, 1], [2, 2, 2]];
  var c = a + b;
  var d = c * c;
  var e = transpose(d);
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_E:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_D:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_C:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<2x3xf64>

# CHECK: affine.for %[[ARG0:.*]] = 0 to 2 {
# CHECK-NEXT: affine.for %[[ARG1:.*]] = 0 to 3 {
# CHECK-NEXT: %[[VAL_A:.*]] = affine.load %[[ALLOC_A]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VAL_B:.*]] = affine.load %[[ALLOC_B]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VAL_C:.*]] = arith.addf %[[VAL_A]], %[[VAL_B]] : f64
# CHECK-NEXT: affine.store %[[VAL_C]], %[[ALLOC_C]][%[[ARG0]], %[[ARG1]]] : memref<2x3xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: affine.for %[[ARG0_2:.*]] = 0 to 2 {
# CHECK-NEXT: affine.for %[[ARG1_2:.*]] = 0 to 3 {
# CHECK-NEXT: %[[VAL_C1:.*]] = affine.load %[[ALLOC_C]][%[[ARG0_2]], %[[ARG1_2]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VAL_C2:.*]] = affine.load %[[ALLOC_C]][%[[ARG0_2]], %[[ARG1_2]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VAL_D:.*]] = arith.mulf %[[VAL_C1]], %[[VAL_C2]] : f64
# CHECK-NEXT: affine.store %[[VAL_D]], %[[ALLOC_D]][%[[ARG0_2]], %[[ARG1_2]]] : memref<2x3xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: affine.for %[[ARG0_3:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[ARG1_3:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VAL_D_T:.*]] = affine.load %[[ALLOC_D]][%[[ARG1_3]], %[[ARG0_3]]] : memref<2x3xf64>
# CHECK-NEXT: affine.store %[[VAL_D_T]], %[[ALLOC_E]][%[[ARG0_3]], %[[ARG1_3]]] : memref<3x2xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: toy.print %[[ALLOC_E]] : memref<3x2xf64>
# CHECK: memref.dealloc %[[ALLOC_A]] : memref<2x3xf64>
# CHECK: memref.dealloc %[[ALLOC_B]] : memref<2x3xf64>
# CHECK: memref.dealloc %[[ALLOC_C]] : memref<2x3xf64>
# CHECK: memref.dealloc %[[ALLOC_D]] : memref<2x3xf64>
# CHECK: memref.dealloc %[[ALLOC_E]] : memref<3x2xf64>
# CHECK: return


