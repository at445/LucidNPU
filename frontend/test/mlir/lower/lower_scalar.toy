# RUN: lucid-c %s -emit=mlir --opt --lower_to_affine 2>&1 | FileCheck %s

def main() {
  var a = 1;
  var b = 2;
  var c = a + b;
  var d = a * b;
  var e = c - d;
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_E:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_D:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_C:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<f64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<f64>
# CHECK: %[[VAL_A:.*]] = affine.load %[[ALLOC_A]][] : memref<f64>
# CHECK: %[[VAL_B:.*]] = affine.load %[[ALLOC_B]][] : memref<f64>
# CHECK: %[[VAL_C:.*]] = arith.addf %[[VAL_A]], %[[VAL_B]] : f64
# CHECK: affine.store %[[VAL_C]], %[[ALLOC_C]][] : memref<f64>
# CHECK: %[[VAL_A2:.*]] = affine.load %[[ALLOC_A]][] : memref<f64>
# CHECK: %[[VAL_B2:.*]] = affine.load %[[ALLOC_B]][] : memref<f64>
# CHECK: %[[VAL_D:.*]] = arith.mulf %[[VAL_A2]], %[[VAL_B2]] : f64
# CHECK: affine.store %[[VAL_D]], %[[ALLOC_D]][] : memref<f64>
# CHECK: %[[VAL_C2:.*]] = affine.load %[[ALLOC_C]][] : memref<f64>
# CHECK: %[[VAL_D2:.*]] = affine.load %[[ALLOC_D]][] : memref<f64>
# CHECK: %[[VAL_E:.*]] = arith.subf %[[VAL_C2]], %[[VAL_D2]] : f64
# CHECK: affine.store %[[VAL_E]], %[[ALLOC_E]][] : memref<f64>
# CHECK: toy.print %[[ALLOC_E]] : memref<f64>
# CHECK: return
