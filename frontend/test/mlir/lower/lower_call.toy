# RUN: lucid-c %s -emit=mlir --opt --lower_to_affine 2>&1 | FileCheck %s

def multiply_transpose(a, b) {
  return transpose(a) * transpose(b);
}

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 1, 1], [2, 2, 2]];
  var c = multiply_transpose(a, b);
  print(c);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_C:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_B_T:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_A_T:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<2x3xf64>

# CHECK: affine.for %[[ARG0_A:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[ARG1_A:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VAL_A:.*]] = affine.load %[[ALLOC_A]][%[[ARG1_A]], %[[ARG0_A]]] : memref<2x3xf64>
# CHECK-NEXT: affine.store %[[VAL_A]], %[[ALLOC_A_T]][%[[ARG0_A]], %[[ARG1_A]]] : memref<3x2xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: affine.for %[[ARG0_B:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[ARG1_B:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VAL_B:.*]] = affine.load %[[ALLOC_B]][%[[ARG1_B]], %[[ARG0_B]]] : memref<2x3xf64>
# CHECK-NEXT: affine.store %[[VAL_B]], %[[ALLOC_B_T]][%[[ARG0_B]], %[[ARG1_B]]] : memref<3x2xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: affine.for %[[ARG0_C:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[ARG1_C:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VAL_A_T:.*]] = affine.load %[[ALLOC_A_T]][%[[ARG0_C]], %[[ARG1_C]]] : memref<3x2xf64>
# CHECK-NEXT: %[[VAL_B_T:.*]] = affine.load %[[ALLOC_B_T]][%[[ARG0_C]], %[[ARG1_C]]] : memref<3x2xf64>
# CHECK-NEXT: %[[VAL_MUL:.*]] = arith.mulf %[[VAL_A_T]], %[[VAL_B_T]] : f64
# CHECK-NEXT: affine.store %[[VAL_MUL]], %[[ALLOC_C]][%[[ARG0_C]], %[[ARG1_C]]] : memref<3x2xf64>
# CHECK-NEXT: }
# CHECK-NEXT: }

# CHECK: toy.print %[[ALLOC_C]] : memref<3x2xf64>
# CHECK: return
