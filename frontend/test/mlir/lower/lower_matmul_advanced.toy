# RUN: lucid-c %s -emit=mlir -opt -lower_to_affine 2>&1 | FileCheck %s

def do_matmul(a, b) {
  return a @ b;
}

def main() {
  var vec = [1, 2, 3];
  var mat1 = [[1, 2], [3, 4], [5, 6]];
  var mat2 = [[1, 2, 3], [4, 5, 6]];

  var r1 = do_matmul(vec, mat1);
  var r2 = do_matmul(mat2, vec);
  var r3 = do_matmul(vec, vec);
  
  print(r1);
  print(r2);
  print(r3);
}

# CHECK:   func.func @main() {
# CHECK-DAG:     %[[ALLOC:.*]] = memref.alloc() : memref<1x1xf64>
# CHECK-DAG:     %[[ALLOC_0:.*]] = memref.alloc() : memref<2x1xf64>
# CHECK-DAG:     %[[ALLOC_1:.*]] = memref.alloc() : memref<3x1xf64>
# CHECK-DAG:     %[[ALLOC_2:.*]] = memref.alloc() : memref<1x2xf64>
# CHECK-DAG:     %[[ALLOC_3:.*]] = memref.alloc() : memref<1x3xf64>
# CHECK-DAG:     %[[ALLOC_4:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG:     %[[ALLOC_5:.*]] = memref.alloc() : memref<3x2xf64>
#
# CHECK:     affine.for %[[ARG0:.*]] = 0 to 1 {
# CHECK-NEXT:       affine.for %[[ARG1:.*]] = 0 to 2 {
# CHECK-NEXT:         %[[CST:.*]] = arith.constant 0.000000e+00 : f64
# CHECK-NEXT:         affine.store %[[CST]], %[[ALLOC_2]][%[[ARG0]], %[[ARG1]]] : memref<1x2xf64>
# CHECK-NEXT:         affine.for %[[ARG2:.*]] = 0 to 3 {
# CHECK-NEXT:           %[[VAL_0:.*]] = affine.load %[[ALLOC_3]][%[[ARG0]], %[[ARG2]]] : memref<1x3xf64>
# CHECK-NEXT:           %[[VAL_1:.*]] = affine.load %[[ALLOC_5]][%[[ARG2]], %[[ARG1]]] : memref<3x2xf64>
# CHECK-NEXT:           %[[VAL_2:.*]] = arith.mulf %[[VAL_0]], %[[VAL_1]] : f64
# CHECK-NEXT:           %[[VAL_3:.*]] = affine.load %[[ALLOC_2]][%[[ARG0]], %[[ARG1]]] : memref<1x2xf64>
# CHECK-NEXT:           %[[VAL_4:.*]] = arith.addf %[[VAL_3]], %[[VAL_2]] : f64
# CHECK-NEXT:           affine.store %[[VAL_4]], %[[ALLOC_2]][%[[ARG0]], %[[ARG1]]] : memref<1x2xf64>
# CHECK-NEXT:         }
# CHECK-NEXT:       }
# CHECK-NEXT:     }
#
# CHECK:     affine.for %[[ARG0_1:.*]] = 0 to 2 {
# CHECK-NEXT:       affine.for %[[ARG1_1:.*]] = 0 to 1 {
# CHECK-NEXT:         %[[CST_1:.*]] = arith.constant 0.000000e+00 : f64
# CHECK-NEXT:         affine.store %[[CST_1]], %[[ALLOC_0]][%[[ARG0_1]], %[[ARG1_1]]] : memref<2x1xf64>
# CHECK-NEXT:         affine.for %[[ARG2_1:.*]] = 0 to 3 {
# CHECK-NEXT:           %[[VAL_0_1:.*]] = affine.load %[[ALLOC_4]][%[[ARG0_1]], %[[ARG2_1]]] : memref<2x3xf64>
# CHECK-NEXT:           %[[VAL_1_1:.*]] = affine.load %[[ALLOC_1]][%[[ARG2_1]], %[[ARG1_1]]] : memref<3x1xf64>
# CHECK-NEXT:           %[[VAL_2_1:.*]] = arith.mulf %[[VAL_0_1]], %[[VAL_1_1]] : f64
# CHECK-NEXT:           %[[VAL_3_1:.*]] = affine.load %[[ALLOC_0]][%[[ARG0_1]], %[[ARG1_1]]] : memref<2x1xf64>
# CHECK-NEXT:           %[[VAL_4_1:.*]] = arith.addf %[[VAL_3_1]], %[[VAL_2_1]] : f64
# CHECK-NEXT:           affine.store %[[VAL_4_1]], %[[ALLOC_0]][%[[ARG0_1]], %[[ARG1_1]]] : memref<2x1xf64>
# CHECK-NEXT:         }
# CHECK-NEXT:       }
# CHECK-NEXT:     }
#
# CHECK:     affine.for %[[ARG0_2:.*]] = 0 to 1 {
# CHECK-NEXT:       affine.for %[[ARG1_2:.*]] = 0 to 1 {
# CHECK-NEXT:         %[[CST_2:.*]] = arith.constant 0.000000e+00 : f64
# CHECK-NEXT:         affine.store %[[CST_2]], %[[ALLOC]][%[[ARG0_2]], %[[ARG1_2]]] : memref<1x1xf64>
# CHECK-NEXT:         affine.for %[[ARG2_2:.*]] = 0 to 3 {
# CHECK-NEXT:           %[[VAL_0_2:.*]] = affine.load %[[ALLOC_3]][%[[ARG0_2]], %[[ARG2_2]]] : memref<1x3xf64>
# CHECK-NEXT:           %[[VAL_1_2:.*]] = affine.load %[[ALLOC_1]][%[[ARG2_2]], %[[ARG1_2]]] : memref<3x1xf64>
# CHECK-NEXT:           %[[VAL_2_2:.*]] = arith.mulf %[[VAL_0_2]], %[[VAL_1_2]] : f64
# CHECK-NEXT:           %[[VAL_3_2:.*]] = affine.load %[[ALLOC]][%[[ARG0_2]], %[[ARG1_2]]] : memref<1x1xf64>
# CHECK-NEXT:           %[[VAL_4_2:.*]] = arith.addf %[[VAL_3_2]], %[[VAL_2_2]] : f64
# CHECK-NEXT:           affine.store %[[VAL_4_2]], %[[ALLOC]][%[[ARG0_2]], %[[ARG1_2]]] : memref<1x1xf64>
# CHECK-NEXT:         }
# CHECK-NEXT:       }
# CHECK-NEXT:     }
#
# CHECK:     toy.print %[[ALLOC_2]] : memref<1x2xf64>
# CHECK-NEXT:     toy.print %[[ALLOC_0]] : memref<2x1xf64>
# CHECK-NEXT:     toy.print %[[ALLOC]] : memref<1x1xf64>
# CHECK-NEXT:     memref.dealloc %[[ALLOC_5]] : memref<3x2xf64>
# CHECK-NEXT:     memref.dealloc %[[ALLOC_4]] : memref<2x3xf64>
# CHECK-NEXT:     memref.dealloc %[[ALLOC_3]] : memref<1x3xf64>
# CHECK-NEXT:     memref.dealloc %[[ALLOC_2]] : memref<1x2xf64>
# CHECK-NEXT:     memref.dealloc %[[ALLOC_1]] : memref<3x1xf64>
# CHECK-NEXT:     memref.dealloc %[[ALLOC_0]] : memref<2x1xf64>
# CHECK-NEXT:     memref.dealloc %[[ALLOC]] : memref<1x1xf64>
# CHECK-NEXT:     return
# CHECK-NEXT:   }