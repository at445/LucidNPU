# RUN: lucid-c %s -emit=mlir -opt 2>&1 | FileCheck %s
#
# ReshapeReshapeOptPattern: reshape(reshape(x)) -> reshape(x)
# FoldReshapeConstantOptPattern: folds the remaining reshape into the constant.

def main() {
  var a<2, 3> = [1, 2, 3, 4, 5, 6];
  var b<3, 2> = a;
  return b;
}

# CHECK: module {
# CHECK: toy.func @main() -> tensor<3x2xf64> {
# CHECK: toy.constant{{.*}}: tensor<3x2xf64>
# CHECK: toy.return %{{[0-9]+}} : tensor<3x2xf64>
# CHECK-NOT: toy.reshape
# CHECK-NOT: error:
