# RUN: lucid-c %s -emit=mlir -opt 2>&1 | FileCheck %s
#
# RedundantReshapeOptPattern: reshape(x) -> x when input and output types match.

def main() {
  var a<3, 2> = [[1],[2], [3], [4], [5], [6]];
  var b<2, 3> = a;
  return b;
}

# CHECK: module {
# CHECK: toy.func @main() -> tensor<2x3xf64> {
# CHECK: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.return %{{[0-9]+}} : tensor<2x3xf64>
# CHECK-NOT: toy.reshape
# CHECK-NOT: error:
