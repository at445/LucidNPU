# RUN: lucid-c %s -emit=mlir 2>&1 | FileCheck %s
#
# matrix_mul (@) extra combinations: vector-matrix and non-square shapes.
# Shape validation / ranked result inference is intentionally not covered.

def main() {
  var v = [1, 2];
  var m = [[1, 2], [3, 4]];
  var n = [[1, 2, 3], [4, 5, 6]];

  var r1 = v @ m;
  var r2 = m @ n;
}

# CHECK: module {
# CHECK: "toy.func"() <{sym_name = "main"}> ({
# CHECK-DAG: toy.constant{{.*}}: tensor<2xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<2x2xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.matrix_mul {{.*}}: tensor<2xf64>, tensor<2x2xf64> -> tensor<*xf64>
# CHECK: toy.matrix_mul {{.*}}: tensor<2x2xf64>, tensor<2x3xf64> -> tensor<*xf64>
# CHECK-NOT: error:
