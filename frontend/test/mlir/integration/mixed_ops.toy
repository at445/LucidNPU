# RUN: lucid-c %s -emit=mlir 2>&1 | FileCheck %s
#
# Integration: operator precedence (element-wise), matrix_mul, ranked result types.
# No explicit return: implicit void return.

def main() {
  var d = [[1,2,3],[4,5,6]] + [[1,2,3],[4,5,6]] / [[1,2,3],[4,5,6]] - [[1,2,3],[4,5,6]] * [[1,2,3],[4,5,6]];
  var e = d @ [1,2,3];
}

# CHECK: module {
# CHECK: toy.func @main() {
# CHECK-NOT: toy.func @main() ->

# Element-wise: A + (B / C) - (D * E)  =>  div, add, mul, sub.
# CHECK: toy.div {{.*}}: tensor<2x3xf64>
# CHECK: toy.add {{.*}}: tensor<2x3xf64>
# CHECK: toy.mul {{.*}}: tensor<2x3xf64>
# CHECK: toy.sub {{.*}}: tensor<2x3xf64>

# CHECK-DAG: toy.constant{{.*}}: tensor<3xf64>

# CHECK: toy.matrix_mul {{.*}}: tensor<2x3xf64>, tensor<3xf64> -> tensor<2xf64>

# CHECK: toy.return
# CHECK-NOT: toy.return %
# CHECK: }
# CHECK: }
# CHECK-NOT: error:
