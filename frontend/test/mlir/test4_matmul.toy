# RUN: lucid-c %s -emit=mlir 2>&1 | FileCheck %s
#
# matrix_mul (@) on constants: matrix-matrix and matrix-vector.
# Note: result type inference / shape validation for matmul is not covered yet.

def main() {
  var m = [[1, 2], [3, 4]];
  var n = [[5, 6], [7, 8]];
  var v = [1, 2];
  var w = [1, 2, 3];
  var a = [[1, 2, 3], [4, 5, 6]];

  var r1 = m @ n;
  var r2 = m @ v;
  var r3 = a @ w;
}

# CHECK: module {
# CHECK: "toy.func"() <{sym_name = "main"}> ({
# CHECK-DAG: toy.constant{{.*}}: tensor<2x2xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<2xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<3xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.matrix_mul {{.*}}: tensor<2x2xf64>, tensor<2x2xf64> -> tensor<*xf64>
# CHECK: toy.matrix_mul {{.*}}: tensor<2x2xf64>, tensor<2xf64> -> tensor<*xf64>
# CHECK: toy.matrix_mul {{.*}}: tensor<2x3xf64>, tensor<3xf64> -> tensor<*xf64>
# CHECK-NOT: error:
