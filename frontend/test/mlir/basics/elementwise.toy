# RUN: lucid-c %s -emit=mlir 2>&1 | FileCheck %s
#
# Element-wise ops on constant operands: scalar and vector.
# Explicit void return.

def main() {
  var a = 1 + 2;
  var b = [1, 2] - [3, 4];
  var c = [2, 4] * [1, 2];
  var d = [6, 8] / [2, 4];
  return;
}

# CHECK: module {
# CHECK: toy.func @main() {
# CHECK-NOT: toy.func @main() ->
# CHECK-DAG: toy.constant dense<1.000000e+00> : tensor<f64>
# CHECK-DAG: toy.constant dense<2.000000e+00> : tensor<f64>
# CHECK: toy.add {{.*}}: tensor<f64>
# CHECK: toy.sub {{.*}}: tensor<2xf64>
# CHECK: toy.mul {{.*}}: tensor<2xf64>
# CHECK: toy.div {{.*}}: tensor<2xf64>
# CHECK: toy.return
# CHECK-NOT: toy.return %
# CHECK-NOT: toy.matrix_mul
# CHECK-NOT: error:
