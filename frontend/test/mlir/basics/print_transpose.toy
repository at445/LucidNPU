# RUN: lucid-c %s -emit=mlir 2>&1 | FileCheck %s
#
# Builtin transpose() and print(): side-effect print stmt, transpose lowering.

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var t = transpose(a);
  print(t);
  print(a);
}

# CHECK: module {
# CHECK: toy.func @main() {
# CHECK-NOT: toy.func @main() ->
# CHECK: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.transpose %{{[0-9]+}} : tensor<2x3xf64> to tensor<*xf64>
# CHECK: toy.print %{{[0-9]+}} : tensor<*xf64>
# CHECK: toy.print %{{[0-9]+}} : tensor<2x3xf64>
# CHECK: toy.return
# CHECK-NOT: toy.return %
# CHECK-NOT: error:
