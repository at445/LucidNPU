# RUN: lucid-c %s -emit=mlir 2>&1 | FileCheck %s
#
# ReshapeOp: explicit type annotation on var reshapes the initializer.
# Covers vector->matrix, matrix->matrix, matrix->vector, and scalar->vector.

def main() {
  var mat<2, 3> = [1, 2, 3, 4, 5, 6];
  var transposed<3, 2> = [[1, 2, 3], [4, 5, 6]];
  var grid = [[1, 2], [3, 4], [5, 6]];
  var flat<6> = grid;
  var one<1> = 1;
  return mat;
}

# CHECK: module {
# CHECK: toy.func @main() -> tensor<2x3xf64> {
# CHECK-DAG: toy.constant{{.*}}: tensor<6xf64>
# CHECK: toy.reshape {{.*}}: tensor<6xf64> -> tensor<2x3xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.reshape {{.*}}: tensor<2x3xf64> -> tensor<3x2xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<3x2xf64>
# CHECK: toy.reshape {{.*}}: tensor<3x2xf64> -> tensor<6xf64>
# CHECK-DAG: toy.constant dense<1.000000e+00> : tensor<f64>
# CHECK: toy.reshape {{.*}}: tensor<f64> -> tensor<1xf64>
# CHECK: toy.return {{.*}}: tensor<2x3xf64>
# CHECK-NOT: error:
