# RUN: lucid-c %s -emit=mlir 2>&1 | FileCheck %s
#
# Scalar / vector / matrix declarations plus same-shape element-wise reuse.

def main() {
  var a = 1;
  var b = [1, 2, 3];
  var c = [[2, 3], [1, 2], [3, 2]];
  var d = b + b;
  var e = c - c;
  var f = a + a;
}

# CHECK: module {
# CHECK: "toy.func"() <{sym_name = "main"}> ({
# CHECK-DAG: toy.constant dense<1.000000e+00> : tensor<f64>
# CHECK-DAG: toy.constant{{.*}}: tensor<3xf64>
# CHECK-DAG: toy.constant{{.*}}: tensor<3x2xf64>
# CHECK: toy.add {{.*}}: tensor<3xf64>
# CHECK: toy.sub {{.*}}: tensor<3x2xf64>
# CHECK: toy.add {{.*}}: tensor<f64>
# CHECK-NOT: toy.matrix_mul
# CHECK-NOT: error:
