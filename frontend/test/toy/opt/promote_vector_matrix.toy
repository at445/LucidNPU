# RUN: lucid-c %s -emit=toy -opt 2>&1 | FileCheck %s

def main() {
    var a = [1, 2, 3];
    var b = [[1], [2], [3]];
    var c = a @ b;
    print(c);
}

# CHECK: toy.func @main()
# CHECK-NEXT: [[VAL_0:%.*]] = toy.constant dense<{{\[\[}}1.000000e+00], [2.000000e+00], [3.000000e+00]]> : tensor<3x1xf64>
# CHECK-NEXT: [[VAL_1:%.*]] = toy.constant dense<{{\[\[}}1.000000e+00, 2.000000e+00, 3.000000e+00]]> : tensor<1x3xf64>
# CHECK-NEXT: [[VAL_2:%.*]] = toy.matrix_mul [[VAL_1]], [[VAL_0]] : tensor<1x3xf64>, tensor<3x1xf64> -> tensor<1x1xf64>
# CHECK-NEXT: toy.print [[VAL_2]] : tensor<1x1xf64>
# CHECK-NEXT: toy.return