# RUN: lucid-c %s -emit=toy 2>&1 | FileCheck %s
#
# Builtin transpose() and print(): side-effect print stmt, transpose type inference.

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var t = transpose(a);
  print(t);
  print(a);
}

# CHECK: module {
# CHECK: toy.func @main() {
# CHECK: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.transpose {{.*}}: tensor<2x3xf64> to tensor<3x2xf64>
# CHECK: toy.print {{.*}}: tensor<3x2xf64>
# CHECK: toy.print {{.*}}: tensor<2x3xf64>
# CHECK: toy.return
# CHECK: }
# CHECK: }
# CHECK-NOT: error:
