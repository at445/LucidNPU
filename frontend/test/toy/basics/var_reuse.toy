# RUN: lucid-c %s -emit=toy 2>&1 | FileCheck %s
#
# Scalar / vector / matrix declarations with same-shape element-wise reuse.
# Unused variables b,c,d,e are eliminated. Only a and f = a + a survive.

def main() {
  var a = 1;
  var b = [1, 2, 3];
  var c = [[2, 3], [1, 2], [3, 2]];
  var d = b + b;
  var e = c - c;
  var f = a + a;
  return f;
}

# CHECK: module {
# CHECK: toy.func @main() -> tensor<f64> {
# CHECK: toy.constant dense<1.000000e+00> : tensor<f64>
# CHECK: toy.add {{.*}}: tensor<f64>
# CHECK: toy.return {{.*}}: tensor<f64>
# CHECK: }
# CHECK: }
# CHECK-NOT: toy.constant{{.*}}tensor<3
# CHECK-NOT: toy.constant{{.*}}tensor<3x2
# CHECK-NOT: toy.sub
# CHECK-NOT: error:
