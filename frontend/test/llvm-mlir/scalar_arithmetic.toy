# RUN: lucid-c %s -emit=LLVM 2>&1 | FileCheck %s
#
# Element-wise scalar arithmetic: add, sub, mul, div.
# Each result is stored but not printed; unused results may be eliminated.
# Verifies llvm.fadd emission for the used result.

def main() {
  var a = 1.0 + 2.0;
  var b = 3.0 - 1.0;
  var c = 2.0 * 3.0;
  var d = 6.0 / 2.0;
  print(a);
}

# CHECK: module {
# CHECK-DAG: llvm.func @printf(!llvm.ptr, ...) -> i32
# CHECK-DAG: llvm.func @malloc(i64) -> !llvm.ptr
# CHECK-DAG: llvm.func @free(!llvm.ptr)
# CHECK: llvm.func @main()
# CHECK: llvm.fadd
# CHECK: llvm.call @printf
# CHECK: llvm.return
# CHECK: }
# CHECK-NOT: error:
