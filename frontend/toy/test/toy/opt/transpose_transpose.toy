# RUN: lucid-toy %s -emit=toy -opt 2>&1 | FileCheck %s
#
# TransposeTransposeOptPattern: transpose(transpose(x)) -> x

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  return transpose(transpose(a));
}

# CHECK: module {
# CHECK: toy.func @main() -> tensor<*xf64> {
# CHECK: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.return %{{[0-9]+}} : tensor<2x3xf64>
# CHECK-NOT: toy.transpose
# CHECK-NOT: error:
