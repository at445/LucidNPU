# RUN: lucid-toy %s -emit=toy -opt 2>&1 | FileCheck %s
#
# FoldReshapeConstantOptPattern: reshape(constant) -> constant'.

def main() {
  var a<2, 3> = [1, 2, 3, 4, 5, 6];
  return a;
}

# CHECK: module {
# CHECK: toy.func @main() -> tensor<2x3xf64> {
# CHECK: toy.constant{{.*}}: tensor<2x3xf64>
# CHECK: toy.return %{{[0-9]+}} : tensor<2x3xf64>
# CHECK-NOT: toy.reshape
# CHECK-NOT: error:
