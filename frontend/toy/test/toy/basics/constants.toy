# RUN: lucid-toy %s -emit=toy 2>&1 | FileCheck %s
#
# Constant declarations without uses are dead code eliminated.

def main() {
  var a = 1;
  var b = [1, 2, 3];
  var c = [[2, 3], [1, 2], [3, 2]];
}

# CHECK: module {
# CHECK: toy.func @main() {
# CHECK: toy.return
# CHECK: }
# CHECK: }
# CHECK-NOT: toy.constant
# CHECK-NOT: error:
