# RUN: lucid-toy %s -emit=toy 2>&1 | FileCheck %s
#
# Element-wise ops on unused results are dead code eliminated.

def main() {
  var a = 1 + 2;
  var b = [1, 2] - [3, 4];
  var c = [2, 4] * [1, 2];
  var d = [6, 8] / [2, 4];
  return;
}

# CHECK: module {
# CHECK: toy.func @main() {
# CHECK: toy.return
# CHECK: }
# CHECK: }
# CHECK-NOT: toy.add
# CHECK-NOT: toy.sub
# CHECK-NOT: toy.mul
# CHECK-NOT: toy.div
# CHECK-NOT: toy.constant
# CHECK-NOT: error:
