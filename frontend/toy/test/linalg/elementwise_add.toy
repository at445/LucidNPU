# RUN: lucid-toy %s -emit=linalg 2>&1 | FileCheck %s
#
# AddOpLowering: toy add lowers to linalg.add in destination-passing style —
# a tensor.empty init as the `outs` operand and the two inputs as `ins`.
# Exercises both ranked (2x2) and 0-d (scalar) tensor shapes. Unlike the
# reshape tests, the constant operands here stay arith.constant (no reshape
# is introduced), so the elementwise op is matched directly.

def main() {
  var a<2, 2> = [1, 2, 3, 4];
  var b<2, 2> = [5, 6, 7, 8];
  print(a + b);

  var x = 6;
  var y = 3;
  print(x + y);
}

# CHECK: module {
# CHECK: func.func @main()
# CHECK: %[[A:.*]] = arith.constant {{.*}} : tensor<2x2xf64>
# CHECK: %[[B:.*]] = arith.constant {{.*}} : tensor<2x2xf64>
# CHECK: %[[INIT:.*]] = tensor.empty() : tensor<2x2xf64>
# CHECK-NEXT: %[[SUM:.*]] = linalg.add ins(%[[A]], %[[B]] : tensor<2x2xf64>, tensor<2x2xf64>) outs(%[[INIT]] : tensor<2x2xf64>) -> tensor<2x2xf64>
# CHECK-NEXT: %[[CAST:.*]] = tensor.cast %[[SUM]] : tensor<2x2xf64> to tensor<?x?xf64>
# CHECK-NEXT: call @lucid_print_2d(%[[CAST]]) : (tensor<?x?xf64>) -> ()
# CHECK: %[[INIT_S:.*]] = tensor.empty() : tensor<f64>
# CHECK-NEXT: %[[SUM_S:.*]] = linalg.add ins(%{{.*}}, %{{.*}} : tensor<f64>, tensor<f64>) outs(%[[INIT_S]] : tensor<f64>) -> tensor<f64>
# CHECK-NEXT: call @lucid_print_0d(%[[SUM_S]]) : (tensor<f64>) -> ()
# CHECK-NOT: toy.add
# CHECK-NOT: error:
# CHECK: }
