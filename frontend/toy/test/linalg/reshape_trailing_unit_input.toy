# RUN: lucid-toy %s -emit=linalg 2>&1 | FileCheck %s
#
# ReshapeOpLowering regression: collapse-then-expand path with a trailing
# size-1 dim in the input (2x3x1 -> 3x2). The union point is the flat 6;
# the input's trailing 1 is greedily consumed by getCollapseUnionPoint and
# absorbed into the collapse reassociation group ([[0, 1, 2]]) instead of
# becoming a bogus size-1 union segment.
# The reshape input is produced by `a + a` (non-constant), otherwise the
# inliner's canonicalization folds reshape(constant) before this lowering.

def main() {
  var a<2, 3, 1> = [1, 2, 3, 4, 5, 6];
  var t = a + a;
  var m<3, 2> = t;
  print(m);
}

# CHECK: module {
# CHECK: func.func @main()
# CHECK: %[[SUM:.*]] = linalg.add {{.*}} -> tensor<2x3x1xf64>
# CHECK-NEXT: %[[COLLAPSED:.*]] = tensor.collapse_shape %[[SUM]] {{\[\[0, 1, 2\]\]}} : tensor<2x3x1xf64> into tensor<6xf64>
# CHECK-NEXT: %[[EXPANDED:.*]] = tensor.expand_shape %[[COLLAPSED]] {{\[\[0, 1\]\]}} output_shape [3, 2] : tensor<6xf64> into tensor<3x2xf64>
# CHECK-NEXT: %[[CAST:.*]] = tensor.cast %[[EXPANDED]] : tensor<3x2xf64> to tensor<?x?xf64>
# CHECK-NEXT: call @lucid_print_2d(%[[CAST]]) : (tensor<?x?xf64>) -> ()
# CHECK-NOT: toy.reshape
# CHECK-NOT: error:
# CHECK: }
