# RUN: lucid-toy %s -emit=linalg 2>&1 | FileCheck %s
#
# ReshapeOpLowering: pure collapse that only drops a size-1 dim
# (2x1x3 -> 2x3). The size-1 input dim is merged into the reassociation
# group of its neighbor ([[0], [1, 2]]).
# The reshape input is produced by `a + a` (non-constant), otherwise the
# inliner's canonicalization folds reshape(constant) before this lowering.

def main() {
  var a<2, 1, 3> = [1, 2, 3, 4, 5, 6];
  var t = a + a;
  var m<2, 3> = t;
  print(m);
}

# CHECK: module {
# CHECK: func.func @main()
# CHECK: %[[SUM:.*]] = linalg.add {{.*}} -> tensor<2x1x3xf64>
# CHECK-NEXT: %[[COLLAPSED:.*]] = tensor.collapse_shape %[[SUM]] {{\[\[0\], \[1, 2\]\]}} : tensor<2x1x3xf64> into tensor<2x3xf64>
# CHECK-NEXT: %[[CAST:.*]] = tensor.cast %[[COLLAPSED]] : tensor<2x3xf64> to tensor<?x?xf64>
# CHECK-NEXT: call @lucid_print_2d(%[[CAST]]) : (tensor<?x?xf64>) -> ()
# CHECK-NOT: toy.reshape
# CHECK-NOT: error:
# CHECK: }
