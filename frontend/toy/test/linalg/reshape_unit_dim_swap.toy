# RUN: lucid-toy %s -emit=linalg 2>&1 | FileCheck %s
#
# ReshapeOpLowering: size-1 dims on both sides with equal rank
# (1x6 -> 6x1). getReassociationIndicesForReshape rejects equal-rank
# reshapes, so getExpandUnionPoint finds the zippered union 1x6x1:
# expand 1x6 -> 1x6x1, then collapse 1x6x1 -> 6x1.
# The reshape input is produced by `a + a` (non-constant), otherwise the
# inliner's canonicalization folds reshape(constant) before this lowering.

def main() {
  var a<1, 6> = [1, 2, 3, 4, 5, 6];
  var t = a + a;
  var m<6, 1> = t;
  print(m);
}

# CHECK: module {
# CHECK: func.func @main()
# CHECK: %[[SUM:.*]] = linalg.add {{.*}} -> tensor<1x6xf64>
# CHECK-NEXT: %[[EXPANDED:.*]] = tensor.expand_shape %[[SUM]] {{\[\[0\], \[1, 2\]\]}} output_shape [1, 6, 1] : tensor<1x6xf64> into tensor<1x6x1xf64>
# CHECK-NEXT: %[[COLLAPSED:.*]] = tensor.collapse_shape %[[EXPANDED]] {{\[\[0, 1\], \[2\]\]}} : tensor<1x6x1xf64> into tensor<6x1xf64>
# CHECK-NEXT: %[[CAST:.*]] = tensor.cast %[[COLLAPSED]] : tensor<6x1xf64> to tensor<?x?xf64>
# CHECK-NEXT: call @lucid_print_2d(%[[CAST]]) : (tensor<?x?xf64>) -> ()
# CHECK-NOT: toy.reshape
# CHECK-NOT: error:
# CHECK: }
