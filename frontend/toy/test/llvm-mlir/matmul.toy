# RUN: lucid-toy %s -emit=LLVM 2>&1 | FileCheck %s
#
# Matrix multiplication of two 2x2 matrices, then print the result.
# Tests that matmul (@) is lowered through affine to LLVM dialect.

def main() {
  var a = [[1.0, 2.0], [3.0, 4.0]];
  var b = [[5.0, 6.0], [7.0, 8.0]];
  var c = a @ b;
  print(c);
}

# CHECK: module {
# CHECK-DAG: llvm.mlir.global internal constant @nl
# CHECK-DAG: llvm.mlir.global internal constant @frmt_spec
# CHECK-DAG: llvm.func @printf(!llvm.ptr, ...) -> i32
# CHECK-DAG: llvm.func @malloc(i64) -> !llvm.ptr
# CHECK-DAG: llvm.func @free(!llvm.ptr)
# CHECK: llvm.func @main()
# CHECK-DAG: llvm.mlir.constant(1.000000e+00 : f64)
# CHECK-DAG: llvm.mlir.constant(8.000000e+00 : f64)
# CHECK: llvm.call @malloc
# CHECK: llvm.fmul
# CHECK: llvm.fadd
# CHECK: llvm.call @printf
# CHECK: llvm.call @free
# CHECK: llvm.return
# CHECK: }
# CHECK-NOT: error:
