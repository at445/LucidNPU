# RUN: lucid-toy %s -emit=affine -opt 2>&1 | FileCheck %s

def main() {
  var a = 1;
  var b = 2;
  var c = a + b;
  var d = a * b;
  var e = c - d;
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK: %[[ALLOC:.*]] = memref.alloc() : memref<f64>
# CHECK: %[[VAL_ADD:.*]] = arith.addf %{{.*}}, %{{.*}} : f64
# CHECK: %[[VAL_MUL:.*]] = arith.mulf %{{.*}}, %{{.*}} : f64
# CHECK: %[[VAL_SUB:.*]] = arith.subf %[[VAL_ADD]], %[[VAL_MUL]] : f64
# CHECK: affine.store %[[VAL_SUB]], %[[ALLOC]][] : memref<f64>
# CHECK: toy.print %[[ALLOC]] : memref<f64>
# CHECK: return
