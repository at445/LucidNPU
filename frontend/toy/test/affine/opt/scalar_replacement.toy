# RUN: lucid-toy %s -emit=affine -opt 2>&1 | FileCheck %s
#
# Scalar replacement: temporary allocs replaced with scalar register values.

def main() {
  var a = 1;
  var b = 2;
  var c = a + b;
  var d = a * b;
  var e = c - d;
  print(e);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# With -opt, only 1 alloc (result e). a,b are constants, c,d are scalars.
# CHECK: %[[ALLOC:.*]] = memref.alloc() : memref<f64>
# CHECK: %[[ADD:.*]] = arith.addf %{{.*}}, %{{.*}} : f64
# CHECK: %[[MUL:.*]] = arith.mulf %{{.*}}, %{{.*}} : f64
# CHECK: %[[SUB:.*]] = arith.subf %[[ADD]], %[[MUL]] : f64
# CHECK: affine.store %[[SUB]], %[[ALLOC]][] : memref<f64>
# CHECK: toy.print %[[ALLOC]] : memref<f64>
# CHECK: return
