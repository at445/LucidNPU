# RUN: lucid-toy %s -emit=affine 2>&1 | FileCheck %s

def multiply_transpose(a, b) {
  return transpose(a) * transpose(b);
}

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 1, 1], [2, 2, 2]];
  var c = multiply_transpose(a, b);
  print(c);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_RESULT:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_B_T:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_A_T:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<2x3xf64>

# transpose a
# CHECK: affine.for %[[I:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[J:.*]] = 0 to 2 {
# CHECK-NEXT: %[[V:.*]] = affine.load %[[ALLOC_A]][%[[J]], %[[I]]] : memref<2x3xf64>
# CHECK-NEXT: affine.store %[[V]], %[[ALLOC_A_T]][%[[I]], %[[J]]] : memref<3x2xf64>

# transpose b
# CHECK: affine.for %[[I:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[J:.*]] = 0 to 2 {
# CHECK-NEXT: %[[V:.*]] = affine.load %[[ALLOC_B]][%[[J]], %[[I]]] : memref<2x3xf64>
# CHECK-NEXT: affine.store %[[V]], %[[ALLOC_B_T]][%[[I]], %[[J]]] : memref<3x2xf64>

# multiply
# CHECK: affine.for %[[I:.*]] = 0 to 3 {
# CHECK-NEXT: affine.for %[[J:.*]] = 0 to 2 {
# CHECK-NEXT: %[[VA:.*]] = affine.load %[[ALLOC_A_T]][%[[I]], %[[J]]] : memref<3x2xf64>
# CHECK-NEXT: %[[VB:.*]] = affine.load %[[ALLOC_B_T]][%[[I]], %[[J]]] : memref<3x2xf64>
# CHECK-NEXT: %[[VM:.*]] = arith.mulf %[[VA]], %[[VB]] : f64
# CHECK-NEXT: affine.store %[[VM]], %[[ALLOC_RESULT]][%[[I]], %[[J]]] : memref<3x2xf64>

# CHECK: toy.print %[[ALLOC_RESULT]] : memref<3x2xf64>
# CHECK: return
