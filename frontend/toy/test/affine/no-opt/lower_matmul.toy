# RUN: lucid-toy %s -emit=affine 2>&1 | FileCheck %s

def main() {
  var a = [[1, 2, 3], [4, 5, 6]];
  var b = [[1, 2], [3, 4], [5, 6]];
  var c = a @ b;
  print(c);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_C:.*]] = memref.alloc() : memref<2x2xf64>
# CHECK-DAG: %[[ALLOC_B:.*]] = memref.alloc() : memref<3x2xf64>
# CHECK-DAG: %[[ALLOC_A:.*]] = memref.alloc() : memref<2x3xf64>

# CHECK: affine.for %[[I:.*]] = 0 to 2 {
# CHECK-NEXT: affine.for %[[J:.*]] = 0 to 2 {
# CHECK-NEXT: affine.store %{{.*}}, %[[ALLOC_C]][%[[I]], %[[J]]] : memref<2x2xf64>
# CHECK-NEXT: affine.for %[[K:.*]] = 0 to 3 {
# CHECK-NEXT: %[[VA:.*]] = affine.load %[[ALLOC_A]][%[[I]], %[[K]]] : memref<2x3xf64>
# CHECK-NEXT: %[[VB:.*]] = affine.load %[[ALLOC_B]][%[[K]], %[[J]]] : memref<3x2xf64>
# CHECK-NEXT: %[[MUL:.*]] = arith.mulf %[[VA]], %[[VB]] : f64
# CHECK-NEXT: %[[ACC:.*]] = affine.load %[[ALLOC_C]][%[[I]], %[[J]]] : memref<2x2xf64>
# CHECK-NEXT: %[[ADD:.*]] = arith.addf %[[ACC]], %[[MUL]] : f64
# CHECK-NEXT: affine.store %[[ADD]], %[[ALLOC_C]][%[[I]], %[[J]]] : memref<2x2xf64>

# CHECK: toy.print %[[ALLOC_C]] : memref<2x2xf64>
# CHECK: return
