# CHECK: affine.for %{{.*}} = 0 to 2 {
# CHECK: affine.for %{{.*}} = 0 to 3 {
# CHECK: arith.mulf

# vec @ vec -> r3 (1x1)
# CHECK: affine.for %{{.*}} = 0 to 1 {
# CHECK: affine.for %{{.*}} = 0 to 3 {
# CHECK: arith.mulf

# CHECK: toy.print %[[ALLOC_R1]] : memref<1x2xf64>
