# RUN: lucid-toy %s -emit=affine 2>&1 | FileCheck %s

def do_matmul(a, b) {
  return a @ b;
}

def main() {
  var vec = [1, 2, 3];
  var mat1 = [[1, 2], [3, 4], [5, 6]];
  var mat2 = [[1, 2, 3], [4, 5, 6]];

  var r1 = do_matmul(vec, mat1);
  var r2 = do_matmul(mat2, vec);
  var r3 = do_matmul(vec, vec);
  
  print(r1);
  print(r2);
  print(r3);
}

# CHECK-NOT: toy.
# CHECK: func.func @main() {
# CHECK-DAG: %[[ALLOC_R3:.*]] = memref.alloc() : memref<1x1xf64>
# CHECK-DAG: %[[ALLOC_R2:.*]] = memref.alloc() : memref<2x1xf64>
# CHECK-DAG: %[[ALLOC_R1:.*]] = memref.alloc() : memref<1x2xf64>
# CHECK-DAG: %[[ALLOC_VEC:.*]] = memref.alloc() : memref<3x1xf64>
# CHECK-DAG: %[[ALLOC_VEC_T:.*]] = memref.alloc() : memref<1x3xf64>
# CHECK-DAG: %[[ALLOC_MAT2:.*]] = memref.alloc() : memref<2x3xf64>
# CHECK-DAG: %[[ALLOC_MAT1:.*]] = memref.alloc() : memref<3x2xf64>

# vec @ mat1 -> r1 (1x2)
# CHECK: affine.for %{{.*}} = 0 to 1 {
# CHECK: affine.for %{{.*}} = 0 to 3 {
# CHECK: arith.mulf

