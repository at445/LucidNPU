{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Setup",
      "description": "Ninja generator with LLVM and MLIR paths",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "LLVM_DIR": "$env{HOME}/llvm-project/build/lib/cmake/llvm",
        "MLIR_DIR": "$env{HOME}/llvm-project/build/lib/cmake/mlir"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "displayName": "Build Default"
    }
  ]
}