{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (RelWithDebInfo)",
      "description": "Ninja generator with LLVM and MLIR paths",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "LLVM_DIR": "$env{HOME}/llvm-project/build/lib/cmake/llvm",
        "MLIR_DIR": "$env{HOME}/llvm-project/build/lib/cmake/mlir"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug build with -g -O0 for breakpoints",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LLVM_DIR": "$env{HOME}/llvm-project/build/lib/cmake/llvm",
        "MLIR_DIR": "$env{HOME}/llvm-project/build/lib/cmake/mlir"
      }
    },
     {
      "name": "release",
      "displayName": "Release",
      "description": "Release build with -O3",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LLVM_DIR": "$env{HOME}/llvm-project/build/lib/cmake/llvm",
        "MLIR_DIR": "$env{HOME}/llvm-project/build/lib/cmake/mlir"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "displayName": "Build Default"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "displayName": "Build Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "displayName": "Build Release"
    }
  ]
}
